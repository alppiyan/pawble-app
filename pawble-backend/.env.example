# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated allowlist; * permitted in dev only)
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pawble

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=public/uploads
MAX_UPLOAD_MB=50
